{
  "name": "ct-az-common-alert-endpoint",
  "version": "1.4.0",
  "private": true,
  "description": "Azure Function for an HTTP endpoint to receive Azure Monitor alerts that use the Common Alert Schema",
  "homepage": "https://github.com/cu-cit-cloud-team/az-common-alert-endpoint#readme",
  "bugs": {
    "url": "https://github.com/cu-cit-cloud-team/az-common-alert-endpoint/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Sprague",
    "email": "ms388@cornell.edu"
  },
  "repository": {
    "url": "https://github.com/cu-cit-cloud-team/az-common-alert-endpoint/"
  },
  "type": "module",
  "main": "src/alert-endpoint.js",
  "scripts": {
    "changelog": "npx conventional-changelog -p conventionalcommits -n changelog.config.js -i CHANGELOG.md -s && git add CHANGELOG.md",
    "changelog:preview": "npx conventional-changelog -p conventionalcommits -n changelog.config.js -u --stdout -i /dev/null",
    "format": "npx oxfmt src",
    "format:check": "npx oxfmt --check src",
    "func": "cross-env NODE_ENV=development LOCAL_DEV=true func start",
    "func:verbose": "cross-env NODE_ENV=development LOCAL_DEV=true func start --verbose",
    "lint": "npx oxlint src",
    "scratch": "cross-env NODE_ENV=development LOCAL_DEV=true node --trace-warnings ./scratch.js",
    "test": "echo \"No tests yet...\"",
    "version": "npm run changelog"
  },
  "dependencies": {
    "@azure/functions": "4.16.2",
    "@azure/storage-blob": "12.33.0",
    "dayjs": "1.11.21",
    "dotenv": "17.4.2",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "azure-functions-core-tools": "4.12.1",
    "conventional-changelog": "8.1.0",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "cross-env": "10.1.0",
    "cz-git": "1.13.1",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  },
  "engines": {
    "node": ">= 24.x",
    "npm": ">= 11.x"
  },
  "volta": {
    "node": "24.18.0",
    "npm": "11.18.0"
  },
  "packageManager": "npm@11.18.0",
  "allowScripts": {
    "azure-functions-core-tools@4.12.1": true
  }
}
